# syntax=docker/dockerfile:1
# The whole shop as one Bun server: pages from dist/ and the order API.
# Used on Railway (see railway.json). The plain Dockerfile serves pages only.

FROM oven/bun:1-alpine
WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

# Build-time settings: the public address (sitemap, share links) and any
# VITE_* values. Railway passes service variables as build args.
ARG RAILWAY_PUBLIC_DOMAIN
ARG VITE_SITE_URL
ARG VITE_GA_MEASUREMENT_ID
ARG VITE_CONTACT_EMAIL
ARG VITE_SOCIAL_INSTAGRAM

COPY . .
RUN bun run build

ENV NODE_ENV=production
EXPOSE 3000
CMD ["bun", "server/standalone.ts"]
